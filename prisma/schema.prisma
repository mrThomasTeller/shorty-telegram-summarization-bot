datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

model User {
  id        BigInt @id
  firstName Bytes?
  lastName  Bytes?
  username  Bytes?

  messages     Message[]
  summaries    Summary[]
  subscription Subscription?
}

model Chat {
  id                         BigInt   @id
  isMember                   Boolean?
  createdAt                  DateTime @default(now())
  news                       String?
  unsummarizedSymbols        Int      @default(0)
  settings                   Json     @default("{}")
  notifiedItsTimeToSummarize Boolean  @default(false)

  messages     Message[]
  summaries    Summary[]
  subscription Subscription?
}

model Message {
  messageId BigInt
  text      Bytes?
  date      DateTime
  userId    BigInt?
  chatId    BigInt

  from User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([messageId, chatId])
  @@index([date])
}

model Summary {
  id          Int      @id @default(autoincrement())
  date        DateTime
  chatId      BigInt
  userId      BigInt?
  usedPremium Boolean  @default(false)

  chat Chat  @relation(fields: [chatId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model Statistic {
  date             DateTime @id
  addedToChats     Int      @default(0)
  removedFromChats Int      @default(0)
}

model Tariff {
  id                 String @id
  name               String @default("")
  description        String @default("")
  price              Int    @default(0) // rubles + cents (10000 = 100 rubles)
  summaries          Int    @default(0)
  messagesMultiplier Int    @default(1)

  subscriptions  Subscription[]
  activationKeys ActivationKey[]
}

model Subscription {
  id                 BigInt   @id @default(autoincrement())
  tariffId           String
  chatId             BigInt?  @unique
  userId             BigInt?  @unique
  email              String
  subscriberUserId   BigInt   @default(0)
  subscriberUserName String?
  createdAt          DateTime @default(now())
  notifiedAt         DateTime @default(now())

  tariff         Tariff          @relation(fields: [tariffId], references: [id], onUpdate: Cascade)
  chat           Chat?           @relation(fields: [chatId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  activationKeys ActivationKey[]
}

model ActivationKey {
  id                    String  @id @default(uuid())
  tariffId              String
  usedForSubscriptionId BigInt? @map("subscriptionId")

  tariff              Tariff        @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  usedForsubscription Subscription? @relation(fields: [usedForSubscriptionId], references: [id], onDelete: Cascade)
}
