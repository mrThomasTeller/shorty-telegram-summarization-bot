datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

model User {
  id        BigInt    @id
  firstName Bytes?
  lastName  Bytes?
  username  Bytes?
  messages  Message[]
}

model Chat {
  id           BigInt        @id
  isMember     Boolean?
  createdAt    DateTime      @default(now())
  news         String?
  messages     Message[]
  summaries    Summary[]
  subscription Subscription?
}

model Message {
  messageId BigInt
  text      Bytes?
  date      DateTime
  from      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    BigInt?
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    BigInt

  @@id([messageId, chatId])
}

model Summary {
  id          Int      @id @default(autoincrement())
  date        DateTime
  chatId      BigInt
  usedPremium Boolean  @default(false)
  chat        Chat     @relation(fields: [chatId], references: [id])
}

model Statistic {
  date             DateTime @id
  addedToChats     Int      @default(0)
  removedFromChats Int      @default(0)
}

model Tariff {
  id                 BigInt         @id @default(autoincrement())
  name               String
  price              Int
  summaries          Int            @default(0)
  messagesMultiplier Int            @default(1)
  Subscription       Subscription[]
}

model Subscription {
  id       BigInt  @id @default(autoincrement())
  tariffId BigInt
  chatId   BigInt? @unique
  username String? @unique
  email    String
  tariff   Tariff  @relation(fields: [tariffId], references: [id])
  chat     Chat?   @relation(fields: [chatId], references: [id])
}
