datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

model User {
  id        BigInt @id
  firstName Bytes?
  lastName  Bytes?
  username  Bytes?

  messages       Message[]
  summaries      Summary[]
  subscriptions  Subscription[]
  invitedToChats Chat[]
}

model Chat {
  id                         BigInt   @id
  title                      Bytes?
  isMember                   Boolean?
  createdAt                  DateTime @default(now())
  news                       String?
  unsummarizedSymbols        Int      @default(0)
  settings                   Json     @default("{}")
  notifiedItsTimeToSummarize Boolean  @default(false)
  invitedByUserId            BigInt?
  replyKeyboardShown         Boolean  @default(false)

  messages      Message[]
  summaries     Summary[]
  subscriptions Subscription[]

  invitedByUser User? @relation(fields: [invitedByUserId], references: [id])
}

model Message {
  messageId BigInt
  text      Bytes?
  date      DateTime
  userId    BigInt?
  chatId    BigInt

  from User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([messageId, chatId])
  @@index([date])
}

model Summary {
  id          Int      @id @default(autoincrement())
  date        DateTime
  chatId      BigInt
  userId      BigInt?
  usedPremium Boolean  @default(false)

  chat Chat  @relation(fields: [chatId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model Statistic {
  date             DateTime @id
  addedToChats     Int      @default(0)
  removedFromChats Int      @default(0)
}

model Tariff {
  id                 String @id
  name               String @default("")
  description        String @default("")
  price              Int    @default(0) // rubles + cents (10000 = 100 rubles)
  summaries          Int    @default(0)
  messagesMultiplier Int    @default(1)

  subscriptions Subscription[]
}

// todo 2sub сделать статусы подписки
model Subscription {
  id                       BigInt          @id @default(autoincrement())
  tariffId                 String
  chatId                   BigInt?
  userId                   BigInt?
  email                    String?
  subscriberUserId         BigInt
  subscriberUserName       String?
  paymentProvider          PaymentProvider @default(YooKassa)
  paymentMethodId          String?
  renewPeriodMonths        Int             @default(1)
  createdAt                DateTime        @default(now())
  payedAt                  DateTime        @default(now())
  notifiedAt               DateTime?       @default(now())
  expires                  DateTime        @default(now())
  disableSubscriptionCheck Boolean         @default(false)
  triesToRenew             Int             @default(0)
  deactivated              Boolean         @default(false)

  tariff Tariff @relation(fields: [tariffId], references: [id], onUpdate: Cascade)
  chat   Chat?  @relation(fields: [chatId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

enum PaymentProvider {
  YooKassa
}
