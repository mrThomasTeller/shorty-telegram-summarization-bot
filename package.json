{
  "name": "shorty-chat-bot",
  "version": "1.0.4-beta.26",
  "description": "",
  "main": "src/start.ts",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "npm": "please-use-bun",
    "node": ">= 20"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "bun db:gen-types",
    "dev": "bun dev:watch",
    "start": "bun src/start.ts summarizeBotServer",
    "status": "bun server:status",
    "test": "bun check:test",
    "lint": "bun check:lint",
    "commit": "bun git:commit",
    "check:test": "jest src --no-coverage",
    "check:test-only": "jest --no-coverage",
    "check:test-coverage": "jest src",
    "check:lint": "eslint src --ext ts,tsx,js,jsx",
    "check:ts": "tsc --noEmit",
    "check:verify": "bun check:ts && bun check:lint",
    "dev:format": "prettier . --ignore-unknown --write",
    "dev:debug": "bun --inspect src/start.ts summarizeBotServer",
    "dev:watch": "nodemon -x 'bun src/start.ts summarizeBotServer' --ext ts,js,json,jsx,tpl",
    "dev:majestic": "npx majestic",
    "db:create-migration": "prisma migrate dev --name",
    "db:create-empty-migration": "npx prisma migrate dev --create-only",
    "db:gen-types": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:rs": "prisma migrate reset",
    "db:seed": "bun prisma/seed.ts",
    "prod:install": "bun install --prod --frozen-lockfile",
    "git:minor-commit": "bun check:verify && npm --no-git-tag-version version minor && git add -A && git commit --no-verify && git push",
    "git:patch-commit": "bun check:verify && npm --no-git-tag-version version patch && git add -A && git commit --no-verify && git push",
    "git:patch-fcommit": "npm --no-git-tag-version version patch && git add -A && git commit --no-verify && git push",
    "git:commit": "bun check:verify && npm --no-git-tag-version version prerelease && git add -A && git commit --no-verify && git push",
    "git:commit-keep-version": "git add -A && git commit && git push",
    "git:fcommit": "npm --no-git-tag-version version prerelease && git add -A && git commit --no-verify && git push",
    "git:fcommit-keep-version": "git add -A && git commit --no-verify && git push",
    "git:fcommit-staged": "npm --no-git-tag-version version prerelease && git commit --no-verify && git push",
    "git:acommit": "git add -A && git commit --amend --no-edit && git push --force",
    "git:facommit": "git add -A && git commit --amend --no-edit --no-verify && git push --force"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "prisma": {
    "seed": "bun db:seed"
  },
  "dependencies": {
    "@darkobits/fd-name": "^0.1.7",
    "@prisma/client": "^5.3.1",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/lodash": "^4.14.199",
    "@types/node": "^20.7.0",
    "@types/node-telegram-bot-api": "^0.61.8",
    "chatgpt": "^5.2.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "fp-ts": "^2.16.1",
    "i18next": "^23.5.1",
    "lodash": "^4.17.21",
    "mockdate": "^3.0.5",
    "node-telegram-bot-api": "^0.63.0",
    "only-allow": "^1.2.0",
    "prisma": "^5.3.1",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.1",
    "ts-pattern": "^5.1.1",
    "typescript": "^5.4.5",
    "utility-types": "^3.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-sonarjs": "^0.21.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1"
  }
}
